<Window x:Class="WoWRetroLauncher2.LauncherUpdateAvailableDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WoWRetroLauncher2"
        mc:Ignorable="d"
        Title="LauncherUpdateAvailableDialog" Height="120" Width="450"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Topmost="True">
    <Grid Background="Black">
        <StackPanel Orientation="Vertical" Margin="0, 24">
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Top" Width="350" TextWrapping="Wrap" TextAlignment="Center" FontFamily="Candara" Foreground="White">An update is available for World of Warcraft Retro Launcher.</TextBlock>
            <TextBlock Name="MyVersion" HorizontalAlignment="Center" Margin="0, 8, 0, 0" VerticalAlignment="Top" Width="350" TextWrapping="Wrap" TextAlignment="Center" FontFamily="Candara" Foreground="Red">Your version: </TextBlock>
            <TextBlock Name="NewVersion" HorizontalAlignment="Center" VerticalAlignment="Top" Width="350" TextWrapping="Wrap" TextAlignment="Center" FontFamily="Candara" Foreground="Lime">New version: </TextBlock>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Width="127" Height="23" VerticalAlignment="Bottom" Margin="0, 10" Style="{StaticResource RedButton}" Click="Close" MouseEnter="PlayHoverSound">
                <Label FontFamily="Candara" Foreground="#aaa" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center">No thanks</Label>
            </Button>
            <Button Width="127" Height="23" VerticalAlignment="Bottom" Margin="0, 10" Style="{StaticResource RedButton}" Click="OpenGithub" MouseEnter="PlayHoverSound">
                <Label FontFamily="Candara" Foreground="#fd0" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center">Download new</Label>
            </Button>
        </StackPanel>

        <Rectangle Width="Auto" Height="16" VerticalAlignment="Bottom" Margin="-4">
            <Rectangle.Fill>
                <ImageBrush ImageSource="/Resources/dialog/dialogframe-bot.png"
                            Viewport="0, 0, 32, 16"
                            Stretch="Fill"
                            ViewportUnits="Absolute"
                            TileMode="Tile"/>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle Width="Auto" Height="16" VerticalAlignment="Top" Margin="-2">
            <Rectangle.Fill>
                <ImageBrush ImageSource="/Resources/dialog/dialogframe-top.png"
                            Viewport="0, 0, 32, 16"
                            Stretch="Fill"
                            ViewportUnits="Absolute"
                            TileMode="Tile"/>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle Width="16" Height="Auto" HorizontalAlignment="Left" Margin="-2">
            <Rectangle.Fill>
                <ImageBrush ImageSource="/Resources/dialog/dialogframe-left.png"
                            Viewport="0, 0, 16, 32"
                            Stretch="Fill"
                            ViewportUnits="Absolute"
                            TileMode="Tile"/>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle Width="16" Height="Auto" HorizontalAlignment="Right" Margin="-4">
            <Rectangle.Fill>
                <ImageBrush ImageSource="/Resources/dialog/dialogframe-right.png"
                            Viewport="0, 0, 16, 32"
                            Stretch="Fill"
                            ViewportUnits="Absolute"
                            TileMode="Tile"/>
            </Rectangle.Fill>
        </Rectangle>
        <Image Source="/Resources/Dialog/dialogframe-topleft.png" Width="64" Height="64" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-3"/>
        <Image Source="/Resources/Dialog/dialogframe-botleft.png" Width="64" Height="64" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-3, -4"/>
        <Image Source="/Resources/Dialog/dialogframe-topright.png" Width="64" Height="64" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="-4, -3"/>
        <Image Source="/Resources/Dialog/dialogframe-botright.png" Width="64" Height="64" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="-4"/>
    </Grid>
</Window>
