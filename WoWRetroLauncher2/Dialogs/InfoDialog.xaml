<Window x:Class="WoWRetroLauncher2.InfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WoWRetroLauncher2"
        mc:Ignorable="d"
        Title="InfoDialog" Height="240" Width="450"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Topmost="True">
    <Grid Background="Black">
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0, 24" Width="350" TextWrapping="Wrap" TextAlignment="Center" FontFamily="Candara" Foreground="White">
            World of Warcraft Retro Launcher v2.0.0 <LineBreak/>
            This piece of software was developed by Parqldev. <LineBreak/><LineBreak/>
            No AI tools of any kind were involved in development of this project. <LineBreak/>
            This includes code, graphics and everything else.<LineBreak/><LineBreak/>
            Discord: @parql.dev<LineBreak/>
            BlueSky: @parql.dev<LineBreak/><LineBreak/>
            All rights belong to Blizzard Entertainment.
        </TextBlock>
        <Button Width="127" Height="23" VerticalAlignment="Bottom" Margin="0, 10" Style="{StaticResource RedButton}" Click="Close" MouseEnter="PlayHoverSound">
            <Label FontFamily="Candara" Foreground="#fd0" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center">Okay</Label>
        </Button>

        <Rectangle Width="Auto" Height="16" VerticalAlignment="Bottom" Margin="-4">
            <Rectangle.Fill>
                <ImageBrush ImageSource="/Resources/dialog/dialogframe-bot.png"
                            Viewport="0, 0, 32, 16"
                            Stretch="Fill"
                            ViewportUnits="Absolute"
                            TileMode="Tile"/>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle Width="Auto" Height="16" VerticalAlignment="Top" Margin="-2">
            <Rectangle.Fill>
                <ImageBrush ImageSource="/Resources/dialog/dialogframe-top.png"
                            Viewport="0, 0, 32, 16"
                            Stretch="Fill"
                            ViewportUnits="Absolute"
                            TileMode="Tile"/>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle Width="16" Height="Auto" HorizontalAlignment="Left" Margin="-2">
            <Rectangle.Fill>
                <ImageBrush ImageSource="/Resources/dialog/dialogframe-left.png"
                            Viewport="0, 0, 16, 32"
                            Stretch="Fill"
                            ViewportUnits="Absolute"
                            TileMode="Tile"/>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle Width="16" Height="Auto" HorizontalAlignment="Right" Margin="-4">
            <Rectangle.Fill>
                <ImageBrush ImageSource="/Resources/dialog/dialogframe-right.png"
                            Viewport="0, 0, 16, 32"
                            Stretch="Fill"
                            ViewportUnits="Absolute"
                            TileMode="Tile"/>
            </Rectangle.Fill>
        </Rectangle>
        <Image Source="/Resources/Dialog/dialogframe-topleft.png" Width="64" Height="64" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-3"/>
        <Image Source="/Resources/Dialog/dialogframe-botleft.png" Width="64" Height="64" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-3, -4"/>
        <Image Source="/Resources/Dialog/dialogframe-topright.png" Width="64" Height="64" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="-4, -3"/>
        <Image Source="/Resources/Dialog/dialogframe-botright.png" Width="64" Height="64" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="-4"/>
    </Grid>
</Window>
