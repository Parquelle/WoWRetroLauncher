<Window x:Class="WoWRetroLauncher2.GameUpdatesAvailableDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WoWRetroLauncher2"
        mc:Ignorable="d"
        Title="GameUpdatesAvailableDialog" Height="280" Width="450"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Topmost="True">
    <Grid Background="Black">
        <StackPanel Name="MainPanel" Orientation="Vertical" Margin="20, 24">
            <TextBlock Name="DialogTitle" HorizontalAlignment="Center" VerticalAlignment="Top" Width="350" TextWrapping="Wrap" TextAlignment="Center" FontFamily="Candara" Foreground="#fd0" FontSize="14">You have {0} update(s) available on the Battle.net app</TextBlock>
            <TextBlock Name="NewVersions" HorizontalAlignment="Left" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Left" FontFamily="Candara" Foreground="White" Margin="8, 24" FontSize="14"><LineBreak/></TextBlock>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Width="127" Height="23" VerticalAlignment="Bottom" Margin="0, 10" Style="{StaticResource RedButton}" Click="Close">
                <Label FontFamily="Candara" Foreground="#aaa" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" MouseEnter="PlayHoverSound">No thanks</Label>
            </Button>
            <Button Width="127" Height="23" VerticalAlignment="Bottom" Margin="0, 10" Style="{StaticResource RedButton}" Click="OpenBnet" MouseEnter="PlayHoverSound">
                <Label FontFamily="Candara" Foreground="#fd0" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center">Take me there!</Label>
            </Button>
        </StackPanel>

        <Rectangle Width="Auto" Height="16" VerticalAlignment="Bottom" Margin="-4">
            <Rectangle.Fill>
                <ImageBrush ImageSource="/Resources/dialog/dialogframe-bot.png"
                            Viewport="0, 0, 32, 16"
                            Stretch="Fill"
                            ViewportUnits="Absolute"
                            TileMode="Tile"/>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle Width="Auto" Height="16" VerticalAlignment="Top" Margin="-2">
            <Rectangle.Fill>
                <ImageBrush ImageSource="/Resources/dialog/dialogframe-top.png"
                            Viewport="0, 0, 32, 16"
                            Stretch="Fill"
                            ViewportUnits="Absolute"
                            TileMode="Tile"/>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle Width="16" Height="Auto" HorizontalAlignment="Left" Margin="-2">
            <Rectangle.Fill>
                <ImageBrush ImageSource="/Resources/dialog/dialogframe-left.png"
                            Viewport="0, 0, 16, 32"
                            Stretch="Fill"
                            ViewportUnits="Absolute"
                            TileMode="Tile"/>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle Width="16" Height="Auto" HorizontalAlignment="Right" Margin="-4">
            <Rectangle.Fill>
                <ImageBrush ImageSource="/Resources/dialog/dialogframe-right.png"
                            Viewport="0, 0, 16, 32"
                            Stretch="Fill"
                            ViewportUnits="Absolute"
                            TileMode="Tile"/>
            </Rectangle.Fill>
        </Rectangle>
        <Image Source="/Resources/Dialog/dialogframe-topleft.png" Width="64" Height="64" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-3"/>
        <Image Source="/Resources/Dialog/dialogframe-botleft.png" Width="64" Height="64" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-3, -4"/>
        <Image Source="/Resources/Dialog/dialogframe-topright.png" Width="64" Height="64" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="-4, -3"/>
        <Image Source="/Resources/Dialog/dialogframe-botright.png" Width="64" Height="64" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="-4"/>
    </Grid>
</Window>
