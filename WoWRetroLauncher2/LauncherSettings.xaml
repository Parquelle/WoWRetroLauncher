<Window x:Class="WoWRetroLauncher2.LauncherSettings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WoWRetroLauncher2"
        mc:Ignorable="d"
        Title="LauncherSettings" Height="450" Width="800">
    <Grid>
        <TabControl TabStripPlacement="Left">
            <TabItem Header="WoW data">
                <StackPanel>
                    <DockPanel Height="32">
                        <Label>'World of Warcraft' data path:</Label>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBox Width="256"/>
                            <Button>
                                Load
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </TabItem>
            <TabItem Header="Appearance">
                <Label>Skins, background, icon, logo</Label>
            </TabItem>
            <TabItem Header="Buttons and news">
                <Label>Banner, news list</Label>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
