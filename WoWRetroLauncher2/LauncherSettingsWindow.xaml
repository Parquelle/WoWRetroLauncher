<Window x:Class="WoWRetroLauncher2.LauncherSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WoWRetroLauncher2"
        mc:Ignorable="d"
        Title="Launcher settings" Height="450" Width="800"
        ResizeMode="NoResize"
        WindowStyle="None"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Background="Black">
        <Border BorderBrush="#aaa" BorderThickness="2" HorizontalAlignment="Left" Margin="24, 48" Width="124" />
        <TabControl TabStripPlacement="Left" Background="Transparent" Margin="24, 48" BorderThickness="0" SelectionChanged="OnTabSwitch">
            <TabItem Header="WoW data" Width="120">
                <Border Margin="32, 0, 0, 0" BorderBrush="#aaa" BorderThickness="2" Padding="8">
                    <StackPanel Background="Black">
                        <Label FontFamily="Candara" Foreground="#fd0" FontSize="18" FontWeight="SemiBold">WoW Data</Label>
                        <Label FontFamily="Candara" Foreground="LightGray" FontSize="12" FontWeight="Normal" Padding="4, 0">This path should go to your 'World of Warcraft' installation.</Label>
                        <Label FontFamily="Candara" Foreground="LightGray" FontSize="12" FontWeight="Normal" Padding="4, 0">The folder should contain subfolders like __retail__ , __classic__ and so forth.</Label>
                        <DockPanel Height="32">
                            <Label FontFamily="Candara" Foreground="White" FontSize="14" FontWeight="SemiBold">WoW data path:</Label>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBox Name="DatapathField" Width="256" Height="24" Background="#222" BorderBrush="#666" Margin="4, 0" Foreground="White" FontFamily="Candara" VerticalContentAlignment="Center"/>
                                <Button Style="{StaticResource RedButton}" Click="LoadDatapath">
                                    <Label FontFamily="Candara" Foreground="#fd0" HorizontalAlignment="Center" VerticalAlignment="Center">Load</Label>
                                </Button>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </TabItem>
            <TabItem Header="Appearance" Width="120">
                <Border Margin="32, 0, 0, 0" BorderBrush="#aaa" BorderThickness="2" Padding="8">
                    <!--<ScrollViewer>-->
                        <StackPanel Background="Black" CanVerticallyScroll="True">
                            <!--
                            <Label FontFamily="Candara" Foreground="#fd0" FontSize="18" FontWeight="SemiBold">Appearance</Label>
                            <DockPanel Height="32">
                                <Label FontFamily="Candara" Foreground="White" FontSize="14" FontWeight="SemiBold">Use pixel perfect graphics</Label>
                                <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Label FontFamily="Presets" Foreground="#fd0" FontSize="18" FontWeight="SemiBold">Presets</Label>
                            <DockPanel Height="32">
                                <Label FontFamily="Candara" Foreground="White" FontSize="14" FontWeight="SemiBold">Apply preset</Label>
                                <ComboBox Template="{DynamicResource Dropdown}" 
                                  Width="150" Height="25" 
                                  Background="Black" Foreground="White" 
                                  SelectedValue="0" 
                                  HorizontalContentAlignment="Right" VerticalContentAlignment="Center" 
                                  FontSize="16" Padding="12, 0" FontFamily="Candara" FontWeight="SemiBold"
                                  IsEnabled="False">
                                </ComboBox>
                            </DockPanel>
                            <Label FontFamily="Presets" Foreground="#fd0" FontSize="18" FontWeight="SemiBold">Skins</Label>
                            <DockPanel Height="32">
                                <Label FontFamily="Candara" Foreground="White" FontSize="14" FontWeight="SemiBold">Allow custom titlebars</Label>
                                <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Height="32">
                                <Label FontFamily="Candara" Foreground="White" FontSize="14" FontWeight="SemiBold">Apply skin</Label>
                                <ComboBox Template="{DynamicResource Dropdown}" 
                                  Width="150" Height="25" 
                                  Background="Black" Foreground="White" 
                                  SelectedValue="0" 
                                  HorizontalContentAlignment="Right" VerticalContentAlignment="Center" 
                                  FontSize="16" Padding="12, 0" FontFamily="Candara" FontWeight="SemiBold"
                                  IsEnabled="False">
                                </ComboBox>
                            </DockPanel>
                    -->
                            <Label FontFamily="Presets" Foreground="#fd0" FontSize="18" FontWeight="SemiBold">Splashes</Label>
                            <DockPanel Height="32">
                                <Label FontFamily="Candara" Foreground="White" FontSize="14" FontWeight="SemiBold">Apply splash</Label>

                            <ComboBox Template="{DynamicResource Dropdown}" 
                                  Name="SplashDropdown" 
                                  Width="150" Height="25" 
                                  Margin="0,0,0,0" 
                                  Background="Black" Foreground="White" 
                                  SelectedValue="0" 
                                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                  HorizontalAlignment="Right"
                                  FontSize="12" Padding="6, 0" FontFamily="Candara" FontWeight="SemiBold">
                            </ComboBox>
                        </DockPanel>
                        <DockPanel Height="32">
                            <Label FontFamily="Candara" Foreground="White" FontSize="14" FontWeight="SemiBold">Randomise splash image</Label>
                            <CheckBox Name="RandomSplashes" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="True"/>
                        </DockPanel>
                        <DockPanel Height="32">
                            <Label FontFamily="Candara" Foreground="White" FontSize="14" FontWeight="SemiBold">Allow developer splash text</Label>
                            <CheckBox Name="DeveloperSplashText" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="True"/>
                        </DockPanel>
                        <DockPanel Height="32">
                            <Label FontFamily="Candara" Foreground="White" FontSize="10" FontWeight="SemiBold" Margin="16, 0, 0, 0" >Allow developer splash images</Label>
                            <CheckBox Name="DeveloperSplashImages" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="True"/>
                        </DockPanel>

                        <!--
                            <DockPanel Height="32">
                                <Label FontFamily="Candara" Foreground="White" FontSize="14" FontWeight="SemiBold">Allow seasonal backgrounds</Label>
                                <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Height="32" Margin="16, 0, 0, 0">
                                <Label FontFamily="Candara" Foreground="White" FontSize="14" FontWeight="SemiBold">Use HD models</Label>
                                <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Label FontFamily="Presets" Foreground="#fd0" FontSize="18" FontWeight="SemiBold">Logos</Label>
                            <Label FontFamily="Presets" Foreground="#fd0" FontSize="18" FontWeight="SemiBold">Profiles</Label>
                    -->
                        </StackPanel>
                    <!--</ScrollViewer>-->
                </Border>
            </TabItem>
            <TabItem Header="Buttons and news" Width="120" IsEnabled="False">
                <Border Margin="32, 0, 0, 0" BorderBrush="#aaa" BorderThickness="2" Padding="8">
                    <ScrollViewer>
                        <StackPanel Background="Black">
                            <DockPanel Height="32">
                                <Label FontFamily="Candara" Foreground="White" FontSize="14" FontWeight="SemiBold">Display customer support warnings</Label>
                                <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Height="32">
                                <Label FontFamily="Candara" Foreground="White" FontSize="14" FontWeight="SemiBold">Ignore hotfixes in Blizz tracker</Label>
                                <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="True"/>
                            </DockPanel>
                            <Label FontFamily="Candara" Foreground="#fd0" FontSize="18" FontWeight="SemiBold">News icons</Label>
                            <DockPanel Height="32">
                                <Label FontFamily="Candara" Foreground="White" FontSize="14" FontWeight="SemiBold">Use history accurate icons</Label>
                                <RadioButton HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Height="32">
                                <Label FontFamily="Candara" Foreground="White" FontSize="14" FontWeight="SemiBold">Use dynamic history accurate icons (experimental)</Label>
                                <RadioButton HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Height="32">
                                <Label FontFamily="Candara" Foreground="White" FontSize="14" FontWeight="SemiBold">Use forum icons</Label>
                                <RadioButton HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Label FontFamily="Candara" Foreground="#fd0" FontSize="18" FontWeight="SemiBold">Banner content</Label>
                            <Label FontFamily="Candara" Foreground="LightGray" FontSize="12" FontWeight="Normal">The banner is not displayed on the Vanilla skin.</Label>
                            <DockPanel Height="32">
                                <Label FontFamily="Candara" Foreground="White" FontSize="14" FontWeight="SemiBold">Do not display banner</Label>
                                <RadioButton HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Height="32">
                                <Label FontFamily="Candara" Foreground="White" FontSize="14" FontWeight="SemiBold">Official news</Label>
                                <RadioButton HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Height="32">
                                <Label FontFamily="Candara" Foreground="White" FontSize="14" FontWeight="SemiBold">Patch notes (experimental)</Label>
                                <RadioButton HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Label FontFamily="Candara" Foreground="#fd0" FontSize="18" FontWeight="SemiBold">News</Label>
                            <DockPanel Height="32">
                                <Label FontFamily="Candara" Foreground="White" FontSize="14" FontWeight="SemiBold">Official news</Label>
                                <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Height="32">
                                <Label FontFamily="Candara" Foreground="White" FontSize="14" FontWeight="SemiBold">Blizz tracker</Label>
                                <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Height="32">
                                <Label FontFamily="Candara" Foreground="White" FontSize="14" FontWeight="SemiBold">Recent forum posts</Label>
                                <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Height="32" Margin="16, 0, 0, 0">
                                <Label FontFamily="Candara" Foreground="White" FontSize="14" FontWeight="SemiBold">Retail</Label>
                                <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Height="32" Margin="16, 0, 0, 0">
                                <Label FontFamily="Candara" Foreground="White" FontSize="14" FontWeight="SemiBold">Classic</Label>
                                <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Height="32" Margin="16, 0, 0, 0">
                                <Label FontFamily="Candara" Foreground="White" FontSize="14" FontWeight="SemiBold">Forever</Label>
                                <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Height="32">
                                <Label FontFamily="Candara" Foreground="White" FontSize="14" FontWeight="SemiBold">Wowhead news</Label>
                                <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Height="32" Margin="16, 0, 0, 0">
                                <Label FontFamily="Candara" Foreground="White" FontSize="14" FontWeight="SemiBold">Retail</Label>
                                <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Height="32" Margin="16, 0, 0, 0">
                                <Label FontFamily="Candara" Foreground="White" FontSize="14" FontWeight="SemiBold">Retail PTR</Label>
                                <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Height="32" Margin="16, 0, 0, 0">
                                <Label FontFamily="Candara" Foreground="White" FontSize="14" FontWeight="SemiBold">Retail Beta</Label>
                                <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Height="32" Margin="16, 0, 0, 0">
                                <Label FontFamily="Candara" Foreground="White" FontSize="14" FontWeight="SemiBold">Classic</Label>
                                <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Height="32" Margin="16, 0, 0, 0">
                                <Label FontFamily="Candara" Foreground="White" FontSize="14" FontWeight="SemiBold">Forever</Label>
                                <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Height="32">
                                <Label FontFamily="Candara" Foreground="White" FontSize="14" FontWeight="SemiBold">IcyVeins news</Label>
                                <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Height="32">
                                <Label FontFamily="Candara" Foreground="White" FontSize="14" FontWeight="SemiBold">RaiderIO news</Label>
                                <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Label FontFamily="Candara" Foreground="#fd0" FontSize="18" FontWeight="SemiBold">Other buttons</Label>
                            <DockPanel Height="32">
                                <Label FontFamily="Candara" Foreground="White" FontSize="14" FontWeight="SemiBold">Show button for patch notes (experimental)</Label>
                                <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Height="32">
                                <Label FontFamily="Candara" Foreground="White" FontSize="14" FontWeight="SemiBold">Show button for the Blizzard Store</Label>
                                <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Height="32">
                                <Label FontFamily="Candara" Foreground="White" FontSize="14" FontWeight="SemiBold">Show buttons for official sites</Label>
                                <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Height="32">
                                <Label FontFamily="Candara" Foreground="White" FontSize="14" FontWeight="SemiBold">Show buttons for community sites</Label>
                                <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Height="32" Margin="16, 0, 0, 0">
                                <Label FontFamily="Candara" Foreground="White" FontSize="14" FontWeight="SemiBold">Wowhead</Label>
                                <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Height="32" Margin="16, 0, 0, 0">
                                <Label FontFamily="Candara" Foreground="White" FontSize="14" FontWeight="SemiBold">IcyVeins</Label>
                                <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Height="32" Margin="16, 0, 0, 0">
                                <Label FontFamily="Candara" Foreground="White" FontSize="14" FontWeight="SemiBold">RaiderIO</Label>
                                <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Height="32" Margin="16, 0, 0, 0">
                                <Label FontFamily="Candara" Foreground="White" FontSize="14" FontWeight="SemiBold">CurseForge</Label>
                                <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Height="32" Margin="16, 0, 0, 0">
                                <Label FontFamily="Candara" Foreground="White" FontSize="14" FontWeight="SemiBold">Petopia</Label>
                                <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Height="32" Margin="16, 0, 0, 0">
                                <Label FontFamily="Candara" Foreground="White" FontSize="14" FontWeight="SemiBold">MMOChampion</Label>
                                <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Height="32" Margin="16, 0, 0, 0">
                                <Label FontFamily="Candara" Foreground="White" FontSize="14" FontWeight="SemiBold">WoWDB</Label>
                                <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Height="32" Margin="16, 0, 0, 0">
                                <Label FontFamily="Candara" Foreground="White" FontSize="14" FontWeight="SemiBold">Housing Hub</Label>
                                <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>
            <TabItem Header="Misc" Width="120">
                <Border Margin="32, 0, 0, 0" BorderBrush="#aaa" BorderThickness="2" Padding="8">
                    <StackPanel Background="Black">
                        <Label FontFamily="Candara" Foreground="#fd0" FontSize="18" FontWeight="SemiBold">Miscellaneous</Label>
                        <DockPanel Height="32">
                            <Label FontFamily="Candara" Foreground="White" FontSize="14" FontWeight="SemiBold">Enable interface sounds</Label>
                            <CheckBox Name="InterfaceSounds" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="True" Checked="OnCheck" Unchecked="OnCheck"/>
                        </DockPanel>
                        <DockPanel Height="32">
                            <Label FontFamily="Candara" Foreground="White" FontSize="14" FontWeight="SemiBold">Enable 'PLAY' sound</Label>
                            <CheckBox Name="PlaySound" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="True" Checked="OnCheck" Unchecked="OnCheck"/>
                        </DockPanel>
                        <DockPanel Height="32">
                            <Label FontFamily="Candara" Foreground="White" FontSize="14" FontWeight="SemiBold">Check for software updates on startup</Label>
                            <CheckBox Name="CheckUpdatesOnStartup" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="True" Checked="OnCheck" Unchecked="OnCheck"/>
                        </DockPanel>
                        <DockPanel Height="32">
                            <Label FontFamily="Candara" Foreground="White" FontSize="14" FontWeight="SemiBold">Warn me when I have outdated game versions</Label>
                            <CheckBox Name="WarnOnOutdatedGame" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="True" Checked="OnCheck" Unchecked="OnCheck"/>
                        </DockPanel>
                        <DockPanel Height="32">
                            <Label FontFamily="Candara" Foreground="White" FontSize="14" FontWeight="SemiBold">Warn me when I seem to have no internet connection</Label>
                            <CheckBox Name="WarnOnNoConnection" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="True" Checked="OnCheck" Unchecked="OnCheck"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>

        <Button Style="{StaticResource RedButton}" Command="{Binding Path=CloseCommand}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16" Click="Close">
            <Label FontFamily="Candara" Foreground="#fd0" HorizontalAlignment="Center" VerticalAlignment="Center">Okay</Label>
        </Button>

        <Rectangle Width="Auto" Height="16" VerticalAlignment="Bottom" Margin="-4">
            <Rectangle.Fill>
                <ImageBrush ImageSource="/Resources/dialog/dialogframe-bot.png"
                            Viewport="0, 0, 32, 16"
                            Stretch="Fill"
                            ViewportUnits="Absolute"
                            TileMode="Tile"/>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle Width="Auto" Height="16" VerticalAlignment="Top" Margin="-2">
            <Rectangle.Fill>
                <ImageBrush ImageSource="/Resources/dialog/dialogframe-top.png"
                            Viewport="0, 0, 32, 16"
                            Stretch="Fill"
                            ViewportUnits="Absolute"
                            TileMode="Tile"/>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle Width="16" Height="Auto" HorizontalAlignment="Left" Margin="-2">
            <Rectangle.Fill>
                <ImageBrush ImageSource="/Resources/dialog/dialogframe-left.png"
                            Viewport="0, 0, 16, 32"
                            Stretch="Fill"
                            ViewportUnits="Absolute"
                            TileMode="Tile"/>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle Width="16" Height="Auto" HorizontalAlignment="Right" Margin="-4">
            <Rectangle.Fill>
                <ImageBrush ImageSource="/Resources/dialog/dialogframe-right.png"
                            Viewport="0, 0, 16, 32"
                            Stretch="Fill"
                            ViewportUnits="Absolute"
                            TileMode="Tile"/>
            </Rectangle.Fill>
        </Rectangle>
        <Image Source="/Resources/Dialog/dialogframe-topleft.png" Width="64" Height="64" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-3"/>
        <Image Source="/Resources/Dialog/dialogframe-botleft.png" Width="64" Height="64" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-3, -4"/>
        <Image Source="/Resources/Dialog/dialogframe-topright.png" Width="64" Height="64" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="-4, -3"/>
        <Image Source="/Resources/Dialog/dialogframe-botright.png" Width="64" Height="64" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="-4"/>
        <Image Name="Header" Source="/Resources/Dialog/ui-dialogbox-header.png" Width="256" VerticalAlignment="Top" Margin="-4"/>
        <Label Foreground="#fd0" FontSize="14" FontFamily="Candara" FontWeight="DemiBold" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="4">
            Settings
        </Label>
    </Grid>
</Window>
