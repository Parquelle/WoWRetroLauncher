<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="bar.png" />
    <None Remove="footer.png" />
    <None Remove="Resources\bar.png" />
    <None Remove="Resources\footer.png" />
    <None Remove="Resources\header.png" />
    <None Remove="Resources\logo_1.png" />
    <None Remove="Resources\vanilla_buttonPlay.png" />
    <None Remove="vanilla_buttonPlay.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\bar.png" />
    <Resource Include="Resources\footer.png" />
    <Resource Include="Resources\header.png" />
    <Resource Include="Resources\logo_1.png" />
    <Resource Include="Resources\vanilla_buttonPlay.png" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
