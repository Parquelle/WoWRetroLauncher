<Window x:Class="WoWRetroLauncher2b.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WoWRetroLauncher2b"
        mc:Ignorable="d"
        Title="World of Warcraft Retro Launcher 2" Width="900" Height="700">
    <Grid Margin="0,0,0,0">
        <DockPanel>
            <Menu DockPanel.Dock="Top">
                <MenuItem Header="Options">
                    <MenuItem Header="Manage game paths"/>
                    <MenuItem Header="Set launcher icon...">
                        <MenuItem Header="Default"/>
                    </MenuItem>
                    <MenuItem Header="Set skin...">
                        <MenuItem Header="Vanilla"/>
                        <MenuItem Header="Wrath of the Lich King" IsEnabled="False"/>
                        <MenuItem Header="Cataclysm" IsEnabled="False"/>
                        <MenuItem Header="Mists of Pandaria" IsEnabled="False"/>
                        <MenuItem Header="Battle.net" IsEnabled="False"/>
                        <Separator />
                        <MenuItem Header="Change with game version" IsEnabled="False"/>
                    </MenuItem>
                    <MenuItem Header="Set background...">
                        <MenuItem Header="Dark Portal"/>
                        <Separator />
                        <MenuItem Header="Change with game version" IsEnabled="False"/>
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="Info" />
            </Menu>
            <StackPanel></StackPanel>
        </DockPanel>

        <Rectangle Width="auto" Height="48" VerticalAlignment="Top" Margin="0,20,0,0">
            <Rectangle.Fill>
                <ImageBrush ImageSource="/Resources/header.png"
                            Viewport="0, 0, 257, 48"
                            Stretch="Fill"
                            ViewportUnits="Absolute"
                            TileMode="Tile"/>
            </Rectangle.Fill>
        </Rectangle>

        <Rectangle Width="266" Height="108" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0, 24, 0, 0">
            <Rectangle.Fill>
                <ImageBrush ImageSource="/Resources/logo_1.png" />
            </Rectangle.Fill>
        </Rectangle>

            <Rectangle Width="auto" Height="15" VerticalAlignment="Bottom" Margin="0, 0, 0, 114">
            <Rectangle.Fill>
                <ImageBrush ImageSource="/Resources/bar.png"
                            Viewport="0, 0, 516, 15"
                            Stretch="Fill"
                            ViewportUnits="Absolute"
                            TileMode="Tile"/>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle Width="auto" Height="114" VerticalAlignment="Bottom" Margin="0,0,0,0">
            <Rectangle.Fill>
                <ImageBrush ImageSource="/Resources/footer.png"
                            Viewport="0, 0, 373, 114"
                            Stretch="Fill"
                            ViewportUnits="Absolute"
                            TileMode="Tile"/>
            </Rectangle.Fill>
        </Rectangle>
        <Button Width="162" Height="92" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10">
            <Button.Background>
                <ImageBrush ImageSource="/Resources/vanilla_buttonPlay.png" />
            </Button.Background>
        </Button>
    </Grid>
</Window>
