<Window x:Class="WoWRetroLauncher2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WoWRetroLauncher2"
        mc:Ignorable="d"
        Icon="/Wow.ico"
        Title="World of Warcraft Retro Launcher v2.0.0" Width="940" Height="740"
        WindowStartupLocation="CenterScreen"
        Background="#808080">
    <Grid Margin="1,1,1,1">
        <Image Name="SplashBackground" Source="/Resources/duskwood.jpg" Stretch="UniformToFill"/>

        <Rectangle Width="900" Height="487" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,128">
            <Rectangle.Fill>
                <ImageBrush ImageSource="/Resources/parchment.png">
                </ImageBrush>
            </Rectangle.Fill>
        </Rectangle>
        
        <StackPanel Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="550" Height="410" Margin="0, 0, 0, 128">
            <Canvas Height="125">
                <Rectangle Width="484" Height="36">
                    <Rectangle.Fill>
                        <ImageBrush ImageSource="/Resources/title.png" />
                    </Rectangle.Fill>
                </Rectangle>

                <Label Margin="10, 14, 0, 0" Foreground="#ddcc00" FontWeight="Bold" FontFamily="Arial" FontSize="12" FontStyle="Italic">
                    News
                </Label>

                <Rectangle Width="38" Height="35"  Margin="10,48,0,0">
                    <Rectangle.Fill>
                        <ImageBrush ImageSource="/Resources/newsicon.png"/>
                    </Rectangle.Fill>
                </Rectangle>

                <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="60, 48, 0, 0" Width="400" MaxHeight="120">
                    <StackPanel Orientation="Horizontal" Width="400">
                        <Image Source="/Resources/bullet.png" Width="12" Height="12" VerticalAlignment="Top" />
                        <TextBlock Name="News1_1" FontFamily="Arial" FontWeight="Bold" Opacity="0.75" FontSize="10" Padding="4,0,0,0" TextWrapping="Wrap" Width="388">
                    ...
                        </TextBlock>
                    </StackPanel>
                    <Separator Background="Black" Opacity="0.5"/>
                    <StackPanel Orientation="Horizontal" Width="400">
                        <Image Source="/Resources/bullet.png" Width="12" Height="12" VerticalAlignment="Top" />
                        <TextBlock Name="News1_2" FontFamily="Arial" FontWeight="Bold" Opacity="0.75" FontSize="10" Padding="4,0,0,0" TextWrapping="Wrap" Width="388">
                    ...
                        </TextBlock>
                    </StackPanel>
                    <Separator Background="Black" Opacity="0.5"/>
                    <StackPanel Orientation="Horizontal" Width="400">
                        <Image Source="/Resources/bullet.png" Width="12" Height="12" VerticalAlignment="Top" />
                        <TextBlock Name="News1_3" FontFamily="Arial" FontWeight="Bold" Opacity="0.75" FontSize="10" Padding="4,0,0,0" TextWrapping="Wrap" Width="388">
                    ...
                        </TextBlock>
                    </StackPanel>
                    <Separator Background="Black" Opacity="0.5"/>
                    <StackPanel Orientation="Horizontal" Width="400">
                        <Image Source="/Resources/bullet.png" Width="12" Height="12" VerticalAlignment="Top" />
                        <TextBlock Name="News1_4" FontFamily="Arial" FontWeight="Bold" Opacity="0.75" FontSize="10" Padding="4,0,0,0" TextWrapping="Wrap" Width="388">
                    ...
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Canvas>

            <Canvas Height="125">
                <Rectangle Width="484" Height="36" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,0,0">
                    <Rectangle.Fill>
                        <ImageBrush ImageSource="/Resources/title_blizz.png" />
                    </Rectangle.Fill>
                </Rectangle>

                <Label HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10, 14, 0, 0" Foreground="#0088dd" FontWeight="Bold" FontFamily="Arial" FontSize="12" FontStyle="Italic">
                    Blizz tracker
                </Label>

                <Rectangle Width="38" Height="35"  Margin="10,48,0,0">
                    <Rectangle.Fill>
                        <ImageBrush ImageSource="/Resources/blizzicon.png"/>
                    </Rectangle.Fill>
                </Rectangle>

                <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="60, 48, 0, 0" Width="400" MaxHeight="120">
                    <StackPanel Orientation="Horizontal" Width="400">
                        <Image Source="/Resources/bullet.png" Width="12" Height="12" VerticalAlignment="Top" />
                        <TextBlock Name="News2_1" FontFamily="Arial" FontWeight="Bold" Opacity="0.75" FontSize="10" Padding="4,0,0,0" TextWrapping="Wrap" Width="388" Foreground="#0088dd">
                    ...
                        </TextBlock>
                    </StackPanel>
                    <Separator Background="Black" Opacity="0.5"/>
                    <StackPanel Orientation="Horizontal" Width="400">
                        <Image Source="/Resources/bullet.png" Width="12" Height="12" VerticalAlignment="Top" />
                        <TextBlock Name="News2_2" FontFamily="Arial" FontWeight="Bold" Opacity="0.75" FontSize="10" Padding="4,0,0,0" TextWrapping="Wrap" Width="388" Foreground="#0088dd">
                    ...
                        </TextBlock>
                    </StackPanel>
                    <Separator Background="Black" Opacity="0.5"/>
                    <StackPanel Orientation="Horizontal" Width="400">
                        <Image Source="/Resources/bullet.png" Width="12" Height="12" VerticalAlignment="Top" />
                        <TextBlock Name="News2_3" FontFamily="Arial" FontWeight="Bold" Opacity="0.75" FontSize="10" Padding="4,0,0,0" TextWrapping="Wrap" Width="388" Foreground="#0088dd">
                    ...
                        </TextBlock>
                    </StackPanel>
                    <Separator Background="Black" Opacity="0.5"/>
                    <StackPanel Orientation="Horizontal" Width="400">
                        <Image Source="/Resources/bullet.png" Width="12" Height="12" VerticalAlignment="Top" />
                        <TextBlock Name="News2_4" FontFamily="Arial" FontWeight="Bold" Opacity="0.75" FontSize="10" Padding="4,0,0,0" TextWrapping="Wrap" Width="388" Foreground="#0088dd">
                    ...
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Canvas>

            <Canvas Height="140">
                <Rectangle Width="484" Height="36" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,0,0">
                    <Rectangle.Fill>
                        <ImageBrush ImageSource="/Resources/title.png" />
                    </Rectangle.Fill>
                </Rectangle>

                <Label HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10, 14, 0, 0" Foreground="#ddcc00" FontWeight="Bold" FontFamily="Arial" FontSize="12" FontStyle="Italic">
                    Wowhead News
                </Label>

                <Rectangle Width="38" Height="35"  Margin="10,48,0,0">
                    <Rectangle.Fill>
                        <ImageBrush ImageSource="/Resources/wowheadicon.png"/>
                    </Rectangle.Fill>
                </Rectangle>

                <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="60, 48, 0, 0" Width="400" MaxHeight="120">
                    <StackPanel Orientation="Horizontal" Width="400">
                        <Image Source="/Resources/bullet.png" Width="12" Height="12" VerticalAlignment="Top" />
                        <TextBlock Name="News3_1" FontFamily="Arial" FontWeight="Bold" Opacity="0.75" FontSize="10" Padding="4,0,0,0" TextWrapping="Wrap" Width="388">
                    ...
                        </TextBlock>
                    </StackPanel>
                    <Separator Background="Black" Opacity="0.5"/>
                    <StackPanel Orientation="Horizontal" Width="400">
                        <Image Source="/Resources/bullet.png" Width="12" Height="12" VerticalAlignment="Top" />
                        <TextBlock Name="News3_2" FontFamily="Arial" FontWeight="Bold" Opacity="0.75" FontSize="10" Padding="4,0,0,0" TextWrapping="Wrap" Width="388">
                    ...
                        </TextBlock>
                    </StackPanel>
                    <Separator Background="Black" Opacity="0.5"/>
                    <StackPanel Orientation="Horizontal" Width="400">
                        <Image Source="/Resources/bullet.png" Width="12" Height="12" VerticalAlignment="Top" />
                        <TextBlock Name="News3_3" FontFamily="Arial" FontWeight="Bold" Opacity="0.75" FontSize="10" Padding="4,0,0,0" TextWrapping="Wrap" Width="388">
                    ...
                        </TextBlock>
                    </StackPanel>
                    <Separator Background="Black" Opacity="0.5"/>
                    <StackPanel Orientation="Horizontal" Width="400">
                        <Image Source="/Resources/bullet.png" Width="12" Height="12" VerticalAlignment="Top" />
                        <TextBlock Name="News3_4" FontFamily="Arial" FontWeight="Bold" Opacity="0.75" FontSize="10" Padding="4,0,0,0" TextWrapping="Wrap" Width="388">
                    ...
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Canvas>
        </StackPanel>

        
        <Rectangle Width="auto" Height="48" VerticalAlignment="Top" Margin="0,16,0,0">
            <Rectangle.Fill>
                <ImageBrush ImageSource="/Resources/header.png"
                            Viewport="0, 0, 257, 48"
                            Stretch="Fill"
                            ViewportUnits="Absolute"
                            TileMode="Tile"/>
            </Rectangle.Fill>
        </Rectangle>

        <Image Source="/Resources/cornerTopLeft.png" HorizontalAlignment="Left" VerticalAlignment="Top" Width="80" Height="82" Margin="0, 64"/>
        <Image Source="/Resources/cornerTopRight.png" HorizontalAlignment="Right" VerticalAlignment="Top" Width="80" Height="82" Margin="0, 64"/>

        <Image Name="SplashForeground" Source="/Resources/stitches.png" Width="560" Height="560" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,128" />

        <Image Source="/Resources/shadow.png" Width="560" Height="560"  HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,128"/>
        <Image Source="/Resources/cornerBottomLeft.png" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="80" Height="82" Margin="0, 128"/>

        <Image Name="SplashText" Source="/Resources/Splashes/Texts/empty.png" Width="560" Height="560" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,128" />

        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="10, 0, 0, 138" >
            <TextBlock Name="VersionLabel" Foreground="Gray"></TextBlock>
            <TextBlock Name="VersionWarning" Foreground="Red" Margin="8, 0"></TextBlock>
        </StackPanel>

        <Rectangle Width="266" Height="108" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0, 24, 0, 0">
            <Rectangle.Fill>
                <ImageBrush ImageSource="/Resources/logo_1.png" />
            </Rectangle.Fill>
        </Rectangle>

        <Rectangle Width="auto" Height="15" VerticalAlignment="Bottom" Margin="0, 0, 0, 114">
            <Rectangle.Fill>
                <ImageBrush ImageSource="/Resources/bar.png"
                            Viewport="0, 0, 516, 15"
                            Stretch="Fill"
                            ViewportUnits="Absolute"
                            TileMode="Tile"/>
            </Rectangle.Fill>
        </Rectangle>

        <Rectangle Width="auto" Height="114" VerticalAlignment="Bottom" Margin="0,0,0,0">
            <Rectangle.Fill>
                <ImageBrush ImageSource="/Resources/footer.png"
                            Viewport="0, 0, 373, 114"
                            Stretch="Fill"
                            ViewportUnits="Absolute"
                            TileMode="Tile"/>
            </Rectangle.Fill>
        </Rectangle>


        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom" Height="114">
            <StackPanel Margin="18,18,0,0">
                <ComboBox Template="{DynamicResource Dropdown}" 
                          Name="GameVersions" 
                          Width="200" Height="34" 
                          Margin="0,0,0,0" 
                          Background="Black" Foreground="White" 
                          SelectedValue="0" 
                          HorizontalContentAlignment="Left" VerticalContentAlignment="Center" 
                          FontSize="16" Padding="12, 0" FontFamily="Candara" FontWeight="SemiBold"
                          DropDownOpened="PlayButtonSound"
                          DropDownClosed="PlayLightButtonSound"
                          MouseEnter="PlayHoverSound"
                          IsEnabled="False">
                </ComboBox>

                <Button Name="LinkBnet" HorizontalAlignment="Center" VerticalAlignment="Bottom" Style="{StaticResource ResourceKey=SmallButton}" Click="PlayButtonSound" MouseEnter="PlayHoverSound">
                    <Image Source="/Resources/Buttons/Titles/battlenet.png" />
                </Button>
            </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Height="114">
            <StackPanel Margin="0,18,0,0">
                <Button Name="LinkForums" HorizontalAlignment="Left" VerticalAlignment="Bottom" Style="{StaticResource ResourceKey=SmallButton}" Click="PlayButtonSound" MouseEnter="PlayHoverSound">
                    <Image Source="/Resources/Buttons/Titles/forums.png" />
                </Button>
                <Button Name="LinkArmory" HorizontalAlignment="Left" VerticalAlignment="Bottom" Style="{StaticResource ResourceKey=SmallButton}" Click="PlayButtonSound" MouseEnter="PlayHoverSound">
                    <Image Source="/Resources/Buttons/Titles/armory.png" />
                </Button>
            </StackPanel>
            <StackPanel Margin="0,18,0,0">
                <Button Name="LinkNews" HorizontalAlignment="Left" VerticalAlignment="Bottom" Style="{StaticResource ResourceKey=SmallButton}" Click="PlayButtonSound" MouseEnter="PlayHoverSound">
                    <Image Source="/Resources/Buttons/Titles/news.png" />
                </Button>
                <Button Name="LinkSupport" HorizontalAlignment="Left" VerticalAlignment="Bottom" Style="{StaticResource ResourceKey=SmallButton}" Click="PlayButtonSound" MouseEnter="PlayHoverSound">
                    <Image Source="/Resources/Buttons/Titles/support.png" />
                </Button>
            </StackPanel>
            <Button Name="Play" Style="{StaticResource ResourceKey=PlayButton}" IsEnabled="False" Click="EnterGame" MouseEnter="PlayHoverSound">
                
            </Button>
        </StackPanel>


        <DockPanel>
            <Menu DockPanel.Dock="Top" Background="Black" Foreground="LightGray">
                <MenuItem Header="Options" SubmenuOpened="PlayLightButtonSound">
                    <MenuItem Name="MenuOptions" Header="Launcher settings" Background="Black" Padding="0" Margin="0" BorderThickness="0"/>
                </MenuItem>
                <MenuItem Header="Info" Click="OpenInfo" />
                <MenuItem Header="GitHub" Click="OpenGithub"/>
                <MenuItem Header="Help" SubmenuOpened="PlayLightButtonSound">
                    <MenuItem Header="Check for updates" Background="Black" Click="ManuallyCheckForUpdates"/>
                    <MenuItem Header="Report bug" Background="Black"/>
                    <MenuItem Header="Submit feedback" Background="Black"/>
                </MenuItem>
            </Menu>
            <StackPanel></StackPanel>
        </DockPanel>
    </Grid>
</Window>
